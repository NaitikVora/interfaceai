# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completions). Used ONLY by `discover`.
# Replay never reads these.
# ---------------------------------------------------------------------------
LLM_API_KEY=sk-replace-with-your-key
LLM_MODEL=gpt-4.1
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=90

# ---------------------------------------------------------------------------
# Local demo application ("DemoBank LegacyCore"). All data is synthetic.
# The access codes below are fake demo credentials for the local app only.
# ---------------------------------------------------------------------------
DEMO_APP_URL=http://localhost:8000
DEMO_APP_PORT=8000
DEMO_OPERATOR_ID=teller1
DEMO_ACCESS_CODE=teller-pass
DEMO_SUPERVISOR_ID=super1
DEMO_SUPERVISOR_CODE=super-pass

# ---------------------------------------------------------------------------
# Browser / runtime
# ---------------------------------------------------------------------------
HEADLESS=true
OPERATOR_PORT=8001
ESCALATION_TIMEOUT_S=900
