  "conditions": [
    {
      "id": "member-not-found",
      "description": "Member search returned no matching member",
      "when": {
        "kind": "text_present",
        "text": "No member found matching"
      },
      "category": "business_outcome",
      "code": "MEMBER_NOT_FOUND",
      "outputs": {
        "status": "not_found"
      },
      "message_from": {
        "css": ".msg-error",
        "fallbacks": []
      },
      "max_attempts": 1
    },
    {
      "id": "insufficient-permission",
      "description": "Operator role may not perform this function",
      "when": {
        "kind": "text_present",
        "text": "do not have permission"
      },
      "category": "business_outcome",
      "code": "INSUFFICIENT_PERMISSION",
      "outputs": {
        "status": "permission_denied"
      },
      "message_from": {
        "css": ".msg-error",
        "fallbacks": []
      },
      "max_attempts": 1
    },
    {
      "id": "validation-rejected",
      "description": "The application rejected the submitted data",
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "text_present",
            "text": "must be"
          },
          {
            "kind": "text_present",
            "text": "is required"
          },
          {
            "kind": "text_present",
            "text": "may contain only"
          }
        ]
      },
      "category": "business_outcome",
      "code": "VALIDATION_REJECTED",
      "outputs": {
        "status": "validation_rejected"
      },
      "message_from": {
        "css": ".msg-error",
        "fallbacks": []
      },
      "max_attempts": 1
    },
    {
      "id": "core-transient",
      "description": "Core system temporarily unavailable; the form is re-rendered with a retry banner",
      "when": {
        "kind": "text_present",
        "text": "temporarily unavailable"
      },
      "category": "recoverable",
      "code": "TRANSIENT_LOAD",
      "outputs": {},
      "recovery": {
        "kind": "retry_step"
      },
      "max_attempts": 2
    },
    {
      "id": "system-notice",
      "description": "Full-page system notice that must be acknowledged",
      "when": {
        "kind": "text_present",
        "text": "System Notice"
      },
      "category": "recoverable",
      "code": "KNOWN_DIALOG",
      "outputs": {},
      "recovery": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Acknowledge",
          "fallbacks": []
        }
      },
      "max_attempts": 2
    },
    {
      "id": "session-refresh",
      "description": "Session about to expire; continuing keeps the session alive",
      "when": {
        "kind": "text_present",
        "text": "session is about to expire"
      },
      "category": "recoverable",
      "code": "SESSION_REFRESH_REQUIRED",
      "outputs": {},
      "recovery": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Continue Session",
          "fallbacks": []
        }
      },
      "max_attempts": 1
    },
    {
      "id": "session-lost",
      "description": "The session expired; the operator must sign in again",
      "when": {
        "kind": "text_present",
        "text": "session has expired"
      },
      "category": "hard_failure",
      "code": "SESSION_LOST",
      "outputs": {},
      "max_attempts": 1
    },
    {
      "id": "authentication-failed",
      "description": "Sign-in was rejected",
      "when": {
        "kind": "text_present",
        "text": "Invalid operator ID or access code"
      },
      "category": "hard_failure",
      "code": "AUTHENTICATION_FAILED",
      "outputs": {},
      "max_attempts": 1
    },
    {
      "id": "application-error",
      "description": "The application raised an unhandled error page",
      "when": {
        "kind": "text_present",
        "text": "Application Error"
      },
      "category": "hard_failure",
      "code": "UNEXPECTED_STATE",
      "outputs": {},
      "max_attempts": 1
    }
  ],
